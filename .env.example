THODARA_APP_ENV=development
THODARA_DATABASE_URL=postgresql+asyncpg://thodara:local-dev-only-change-me@localhost:5432/thodara
THODARA_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080"]
THODARA_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
THODARA_SESSION_TTL_HOURS=8
THODARA_SESSION_COOKIE_SECURE=false
POSTGRES_DB=thodara
POSTGRES_USER=thodara
POSTGRES_PASSWORD=local-dev-only-change-me
# Encrypts authenticator secrets (ADR-0015). Leave unset in development to use the public
# development key; production refuses to start without its own. Generate one with:
#   python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# THODARA_TWO_STEP_KEY=
